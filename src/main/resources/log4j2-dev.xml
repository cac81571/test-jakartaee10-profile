<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="logLevel">${sys:LOG_LEVEL:-${env:LOG_LEVEL:-DEBUG}}</Property>
  </Properties>
  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="com.example" level="${logLevel}"/>
    <Root level="${logLevel}">
      <AppenderRef ref="CONSOLE"/>
    </Root>
  </Loggers>
</Configuration>
